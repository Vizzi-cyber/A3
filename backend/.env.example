# 应用配置
APP_NAME=AI Learning System
APP_VERSION=1.0.0
DEBUG=true
SECRET_KEY=your-secret-key-here-at-least-32-chars-long

# 服务器配置
HOST=0.0.0.0
PORT=8000

# 数据库配置（默认 SQLite，可切换 PostgreSQL）
DATABASE_URL=sqlite:///./ai_learning_v2.db
# PostgreSQL备用: postgresql://user:password@localhost:5432/ai_learning

# Redis配置（可选）
REDIS_URL=redis://localhost:6379/0

# CORS 域名（逗号分隔，追加到默认列表）
# CORS_ORIGINS=https://your-domain.com

# ============================================
# 大模型提供商选择: bigmodel / spark / deepseek / openai
# ============================================
DEFAULT_LLM_PROVIDER=bigmodel

# 科大讯飞配置（HTTP OpenAI 兼容接口）
SPARK_API_KEY=your-spark-api-key
SPARK_HTTP_BASE_URL=https://spark-api-open.xf-yun.com/v1
SPARK_MODEL=generalv3.5

# DeepSeek配置
DEEPSEEK_API_KEY=your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# OpenAI配置
OPENAI_API_KEY=your-openai-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# 智谱AI配置（默认，支持 GLM-4V 图文模型）
BIGMODEL_API_KEY=your-bigmodel-api-key
BIGMODEL_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
BIGMODEL_MODEL=glm-4.6v

# LangSmith配置（可选，用于调试）
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your-langchain-key
LANGCHAIN_PROJECT=ai-learning-system

# ============================================
# 火山方舟（ARK）文生图 - Seedream 3.0
# https://console.volcengine.com/ai/ark
# ============================================
ARK_API_KEY=your-ark-api-key
ARK_IMAGE_ENDPOINT=your-ark-endpoint-id
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3/invoke

# 火山引擎视觉智能 OpenAPI
VOLC_ACCESS_KEY=your-volc-access-key
VOLC_SECRET_KEY=your-volc-secret-key

# 应用配置
APP_NAME=LearnLab
APP_VERSION=1.0.0
DEBUG=false
SECRET_KEY=your-secret-key-here-change-in-production

# 服务器配置
HOST=0.0.0.0
PORT=8000

# 数据库配置
DATABASE_URL=sqlite:///./ai_learning_v2.db
# PostgreSQL备用: postgresql://user:password@localhost:5432/ai_learning

# Redis配置
REDIS_URL=redis://localhost:6379/0

# ============================================
# 大模型提供商选择: spark / deepseek / openai / bigmodel
# ============================================
DEFAULT_LLM_PROVIDER=spark

# 讯飞星火配置（使用讯飞时必填）
SPARK_API_KEY=your-spark-api-key
SPARK_HTTP_BASE_URL=https://spark-api-open.xf-yun.com/v1
SPARK_MODEL=pro-128k

# DeepSeek配置（使用DeepSeek时必填）
DEEPSEEK_API_KEY=your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# OpenAI配置（使用OpenAI时必填）
OPENAI_API_KEY=your-openai-key

# 智谱AI配置（使用 bigmodel 时必填）
BIGMODEL_API_KEY=your-bigmodel-api-key
BIGMODEL_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
BIGMODEL_MODEL=glm-4.6v

# LangSmith配置（可选，用于调试）
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your-langchain-key
LANGCHAIN_PROJECT=learnlab

# ============================================
# 火山方舟（ARK）文生图 - Seedream 3.0
# ============================================
ARK_API_KEY=your-ark-api-key
ARK_IMAGE_ENDPOINT=your-ark-endpoint
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3/invoke

# 火山引擎视觉智能 OpenAPI
VOLC_ACCESS_KEY=your-volc-access-key
VOLC_SECRET_KEY=your-volc-secret-key
